# Copy to .env (gitignored) and fill in.

# Neo4j — AuraDB Free tier (D013). From the Aura console, "Connect" -> copy the
# Connection URI (neo4j+s://<dbid>.databases.neo4j.io) and the generated password
# (shown once, at instance creation — save it, Aura will not show it again).
NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Local Docker Neo4j (docker-compose.yml) still works as a fallback for offline
# work — swap the three lines above for:
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=labgo-local-dev

# Voyage — Stage 3 embeddings (D011). https://dash.voyageai.com/
VOYAGE_API_KEY=

# Inference — Stage 4+ (LangGraph agents).
ANTHROPIC_API_KEY=
