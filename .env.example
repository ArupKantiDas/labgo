# Copy to .env (gitignored) and fill in.

# Neo4j — matches docker-compose.yml defaults; override if you're pointing at
# a different instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=labgo-local-dev

# Voyage — Stage 3 embeddings (D011). https://dash.voyageai.com/
VOYAGE_API_KEY=

# Inference — Stage 4+ (LangGraph agents).
ANTHROPIC_API_KEY=
